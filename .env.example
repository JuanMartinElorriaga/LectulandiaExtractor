# LectulandiaExtractor Configuration
# Copy this file to .env and customize for your environment

# URLs
LECTULANDIA_BASE_URL=https://ww3.lectulandia.com
ANTUPLOAD_BASE_URL=https://www.antupload.com

# Rate Limiting (seconds)
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0
MAX_RETRIES=3

# Fuzzy Matching (0-100)
AUTHOR_MATCH_THRESHOLD=90
BOOK_MATCH_THRESHOLD=90

# Timeouts (seconds)
DOWNLOAD_TIMEOUT=220
REQUEST_TIMEOUT=40
CONNECT_TIMEOUT=15

# Default Paths (customize for your system)
DEFAULT_DOWNLOAD_FOLDER=./downloads
DEFAULT_CALIBRE_LIBRARY=/Users/jelorriaga/Documents/Libros

# Limits
MAX_PAGINATION_DEPTH=50
